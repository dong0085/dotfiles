[user]
	name = eric dong
	email = dong0085@algonquinlive.com
[core]
	editor = code --wait
[init]
	defaultBranch = main
[pull]
	rebase = true
[column]
	ui = auto
[color]
	ui = auto
[diff]
	algorithm = histogram
	renames = true
[alias]
	cleanup-gone = "!git fetch -p && for branch in $(git for-each-ref --format=\"%(refname:short) %(upstream:track)\" refs/heads | awk '$2 == \"[gone]\" {print $1}'); do git branch -D \"$branch\"; done"
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
